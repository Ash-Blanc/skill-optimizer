# ======================
# LLM Provider API Keys
# ======================
# At least one of these is required

# OpenAI (recommended)
OPENAI_API_KEY=sk-...

# Mistral AI
MISTRAL_API_KEY=...

# Google Gemini
GEMINI_API_KEY=...
# or
GOOGLE_API_KEY=...

# ======================
# Optional Configuration
# ======================

# Specify default model for DSPy (optional)
# Format: provider/model-name
# Examples: openai/gpt-4o-mini, mistral/mistral-large-latest, gemini/gemini-1.5-flash
# DSPY_MODEL=openai/gpt-4o-mini

# Use local ollama model for DSPy (optional)
# OLLAMA_MODEL=ollama_chat/qwen3:8b
# OLLAMA_API_BASE=http://127.0.0.1:11434
# OLLAMA_TEMPERATURE=0.2
# OLLAMA_MAX_TOKENS=4096
# OLLAMA_TIMEOUT=1800

# ======================
# LangWatch (for tracing)
# ======================
LANGWATCH_API_KEY=...
